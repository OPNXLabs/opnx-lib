<Project>
  <PropertyGroup>
    <!-- C# defaults -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Common package metadata -->
    <Company>오픈엑스 (OPNX)</Company>
    <Authors>OPNX</Authors>
    <Product>OPNX.Lib</Product>
    <Copyright>Copyright (c) 2026 오픈엑스 (OPNX)</Copyright>

    <!-- Common version: the date follows the local build date; increment only PreviewRevision manually. -->
    <BaseVersion>0.1.0</BaseVersion>
    <PreviewDate>$([System.DateTime]::Now.ToString('yyyyMMdd'))</PreviewDate>
    <PreviewRevision>1</PreviewRevision>
    <Version>$(BaseVersion)-preview.$(PreviewDate).$(PreviewRevision)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- URL -->
    <PackageProjectUrl>https://www.opnx.kr/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OPNXLabs/opnx-lib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- License -->
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <!-- Readme -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NuGet discovery -->
    <PackageTags>opnx;video;vms;nvr;rtsp;streaming;media;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
