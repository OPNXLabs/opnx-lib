<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    <Description>Modular .NET infrastructure SDK for stateful video systems. Preview package for non-commercial evaluation; commercial or production use requires a written OPNX license.</Description>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OPNX.Lib.Common\OPNX.Lib.Common.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Data\OPNX.Lib.Data.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Media\OPNX.Lib.Media.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Network\OPNX.Lib.Network.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Onvif\OPNX.Lib.Onvif.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Streaming\OPNX.Lib.Streaming.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.SystemMonitoring\OPNX.Lib.SystemMonitoring.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DataChannelDotnet" Version="1.3.1" />
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="SkiaSharp" Version="4.156.0-preview.1.26512.10" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\..\License.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\License.ko.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.ko.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\third_party_licenses\Apache-2.0.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\BSD-3-Clause.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\Concentus-Opus-BSD.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\FFmpeg-License-Reference.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\FFmpeg-Native-Binaries-NOTICE.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\FFmpeg.AutoGen-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\Microsoft-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\MySqlConnector-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\ZstdSharp-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\SkiaSharp-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\WebRTC-Native-NOTICE.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\PostgreSQL-License.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\SharpRTSP-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
