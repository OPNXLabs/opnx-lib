<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    <Description>Modular .NET infrastructure SDK for building stateful video systems with networking, media processing, real-time streaming, and database-backed entity storage.</Description>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OPNX.Lib.Common\OPNX.Lib.Common.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Data\OPNX.Lib.Data.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Media\OPNX.Lib.Media.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Network\OPNX.Lib.Network.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OPNX.Lib.Streaming\OPNX.Lib.Streaming.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage"
        DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\..\License.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\License.ko.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.ko.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\third_party_licenses\Apache-2.0.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\BSD-3-Clause.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\Concentus-Opus-BSD.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\FFmpeg-License-Reference.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\FFmpeg-Native-Binaries-NOTICE.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\FFmpeg.AutoGen-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\PostgreSQL-License.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
    <None Include="..\..\third_party_licenses\SharpRTSP-MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
  </ItemGroup>

</Project>
